<div class="max-w-3xl mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold">ブログ記事一覧</h1>
    <% if user_signed_in? %>
      <%= link_to "新しい記事を書く", new_article_path, class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>
    <% end %>
  </div>

  <% if @articles.empty? %>
    <p class="text-gray-500">まだ記事がありません。</p>
  <% else %>
    <% @articles.each do |article| %>
      <div class="flex border rounded-lg p-6 mb-4 shadow-sm">
        <div class="flex-1 flex flex-col">
            <h2 class="text-xl font-semibold mb-2 flex items-center gap-2">
            <%= link_to article.title, article_path(article), class: "hover:underline" %>
            <% if article.published_at.nil? %>
                <span class="text-xs bg-gray-200 text-gray-600 px-2 py-0.5 rounded-full">下書き</span>
            <% end %>
            </h2>
            <p class="text-gray-500 text-sm"><%= article.published_at&.strftime("%Y年%m月%d日") %></p>
            <p class="text-gray-500 text-sm">by <%= article.user.email %></p>
            <p class="mt-2 text-gray-700"><%= truncate(article.body, length: 100) %></p>
        </div>
        <% if article.image.attached? %>
            <%= image_tag article.image, class: "rounded-lg w-[120px] h-[120px] object-cover" %>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
