<div class="max-w-md mx-auto px-4 py-8">
  <h2 class="text-2xl font-bold mb-6">パスワードを変更する</h2>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>

    <div class="space-y-4">
      <div>
        <%= f.label :password, "新しいパスワード", class: "block font-medium mb-1" %>
        <% if @minimum_password_length %>
          <p class="text-sm text-gray-500 mb-1"><%= @minimum_password_length %>文字以上</p>
        <% end %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password",
            class: "w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400" %>
      </div>

      <div>
        <%= f.label :password_confirmation, "新しいパスワード（確認）", class: "block font-medium mb-1" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password",
            class: "w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400" %>
      </div>

      <div>
        <%= f.submit "パスワードを変更する", class: "w-full bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 cursor-pointer" %>
      </div>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
