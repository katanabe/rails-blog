<div class="max-w-md mx-auto px-4 py-8">
  <h2 class="text-2xl font-bold mb-6">ログイン</h2>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <div class="space-y-4">
      <div>
        <%= f.label :email, "メールアドレス", class: "block font-medium mb-1" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
            class: "w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400" %>
      </div>

      <div>
        <%= f.label :password, "パスワード", class: "block font-medium mb-1" %>
        <%= f.password_field :password, autocomplete: "current-password",
            class: "w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="flex items-center gap-2">
          <%= f.check_box :remember_me %>
          <%= f.label :remember_me, "ログイン状態を保持する", class: "text-sm text-gray-600" %>
        </div>
      <% end %>

      <div>
        <%= f.submit "ログイン", class: "w-full bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 cursor-pointer" %>
      </div>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
