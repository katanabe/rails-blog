<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Rails Blog" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Rails Blog">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="bg-white border-b shadow-sm">
      <div class="max-w-3xl mx-auto px-4 py-3 flex justify-between items-center">
        <%= link_to "Rails Blog", root_path, class: "text-xl font-bold text-blue-600" %>

        <div class="flex items-center gap-4">
          <% if user_signed_in? %>
            <span class="text-gray-600 text-sm"><%= current_user.email %></span>
            <%= link_to "新規投稿", new_article_path, class: "text-blue-600 hover:underline text-sm" %>
            <%= button_to "ログアウト", destroy_user_session_path, method: :delete,
                class: "text-sm text-gray-600 hover:underline bg-transparent border-none cursor-pointer" %>
          <% else %>
            <%= link_to "ログイン", new_user_session_path, class: "text-blue-600 hover:underline text-sm" %>
            <%= link_to "サインアップ", new_user_registration_path, class: "bg-blue-600 text-white px-3 py-1 rounded text-sm hover:bg-blue-700" %>
          <% end %>
        </div>
      </div>
    </nav>

    <% if alert %>
      <div class="bg-red-100 text-red-800 px-4 py-2 text-center"><%= alert %></div>
    <% end %>

    <main class="container mx-auto mt-8 px-5">
      <%= yield %>
    </main>
  </body>
</html>
